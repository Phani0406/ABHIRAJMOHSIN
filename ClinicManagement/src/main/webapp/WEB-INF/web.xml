<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
            http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>ClinicManagement</display-name>

  <servlet><servlet-name>AdminLoginServlet</servlet-name><servlet-class>servlet.AdminLoginServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>AdminLoginServlet</servlet-name><url-pattern>/AdminLoginServlet</url-pattern></servlet-mapping>
  
  <servlet>
  <servlet-name>DoctorServlet</servlet-name>
  <servlet-class>servlet.DoctorServlet</servlet-class>
</servlet>
<servlet-mapping>
  <servlet-name>DoctorServlet</servlet-name>
  <url-pattern>/DoctorServlet</url-pattern>
</servlet-mapping>
  

  <servlet><servlet-name>DoctorLoginServlet</servlet-name><servlet-class>servlet.DoctorLoginServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>DoctorLoginServlet</servlet-name><url-pattern>/DoctorLoginServlet</url-pattern></servlet-mapping>

  <servlet><servlet-name>BookAppointmentServlet</servlet-name><servlet-class>servlet.BookAppointmentServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>BookAppointmentServlet</servlet-name><url-pattern>/BookAppointmentServlet</url-pattern></servlet-mapping>

  <servlet><servlet-name>PatientServlet</servlet-name><servlet-class>servlet.PatientServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>PatientServlet</servlet-name><url-pattern>/PatientServlet</url-pattern></servlet-mapping>

  <servlet><servlet-name>PrescriptionServlet</servlet-name><servlet-class>servlet.PrescriptionServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>PrescriptionServlet</servlet-name><url-pattern>/PrescriptionServlet</url-pattern></servlet-mapping>

  <servlet><servlet-name>BillServlet</servlet-name><servlet-class>servlet.BillServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>BillServlet</servlet-name><url-pattern>/BillServlet</url-pattern></servlet-mapping>

  <servlet><servlet-name>LogoutServlet</servlet-name><servlet-class>servlet.LogoutServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>LogoutServlet</servlet-name><url-pattern>/LogoutServlet</url-pattern></servlet-mapping>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>
</web-app>
